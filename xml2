<?xml version="1.0" encoding="ISO-8859-1" ?>
<scenario name="Register and Authenticated Call with Audio">

  <send retrans="500">
    <![CDATA[
      REGISTER sip:[remote_ip] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SENDER_EXT_PLACEHOLDER" <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>;tag=[call_number]
      To: <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>
      Call-ID: [call_id]
      CSeq: 1 REGISTER
      Contact: sip:SENDER_EXT_PLACEHOLDER@[local_ip]:[local_port]
      Max-Forwards: 70
      Expires: 3600
      Content-Length: 0
    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="401" auth="true" rrs="true"/>

  <send retrans="500">
    <![CDATA[
      REGISTER sip:[remote_ip] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SENDER_EXT_PLACEHOLDER" <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>;tag=[call_number]
      To: <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>
      [authentication username=SENDER_EXT_PLACEHOLDER password=*****]
      Call-ID: [call_id]
      CSeq: 2 REGISTER
      Contact: sip:SENDER_EXT_PLACEHOLDER@[local_ip]:[local_port]
      Max-Forwards: 70
      Expires: 3600
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true"/>

  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SENDER_EXT_PLACEHOLDER" <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>;tag=[call_number]
      To: <sip:[service]@[remote_ip]>
      Call-ID: [call_id]
      CSeq: 3 INVITE
      Contact: sip:SENDER_EXT_PLACEHOLDER@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: VoIP Audio Test
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 5365576 2353687737 IN IP4 [local_ip]
      s=SIPp Session
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [rtpstream_audio_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="401" auth="true" rrs="true"/>

  <send>
    <![CDATA[
      ACK sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SENDER_EXT_PLACEHOLDER" <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>;tag=[call_number]
      To: <sip:[service]@[remote_ip]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SENDER_EXT_PLACEHOLDER" <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>;tag=[call_number]
      To: <sip:[service]@[remote_ip]>
      [authentication username=SENDER_EXT_PLACEHOLDER password=******]
      Call-ID: [call_id]
      CSeq: 4 INVITE
      Contact: sip:SENDER_EXT_PLACEHOLDER@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: VoIP Audio Test
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 5365576 2353687737 IN IP4 [local_ip]
      s=SIPp Session
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [rtpstream_audio_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <recv response="183" optional="true"/>
  <recv response="200" rrs="true"/>

  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SENDER_EXT_PLACEHOLDER" <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>;tag=[call_number]
      To: <sip:[service]@[remote_ip]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 4 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="75000"/>

  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SENDER_EXT_PLACEHOLDER" <sip:SENDER_EXT_PLACEHOLDER@[remote_ip]>;tag=[call_number]
      To: <sip:[service]@[remote_ip]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 5 BYE
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true"/>

</scenario>
